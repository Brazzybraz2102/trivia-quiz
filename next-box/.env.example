# Copy to .env and fill in. Never commit .env.
# Each person connects their own to-do app in the web app (Settings → Your to-do app),
# or from the desktop: nextbox connect <user> todoist|caldav
# Your first printer. Add more (any thermal printer, any label color) in the web app: Admin → Printers.
PRINTER_IP=192.168.1.50
# Shared secret the web app, CLI-over-HTTP and Home Assistant send as X-NextBox-Key.
# Generate one with: python3 -c "import secrets; print(secrets.token_urlsafe(24))"
NEXTBOX_KEY=
# For photo read-back (Phase 2 /scan) and the AI helpers ("Break it down", "Look back on my week").
ANTHROPIC_API_KEY=

# Optional
# NEXTBOX_DRY_RUN=1            # never touch the printer; save PNGs instead
# NEXTBOX_DATA_DIR=~/.local/share/nextbox
# NEXTBOX_LABEL=62             # 62 mm continuous tape
# NEXTBOX_VISION_MODEL=claude-sonnet-5-5
# NEXTBOX_COACH_MODEL=claude-opus-5-5   # the AI helpers' model
# NEXTBOX_HOST=0.0.0.0
# NEXTBOX_PORT=8787
# NEXTBOX_RETENTION_DAYS=90     # delete tickets/scans older than this
# NEXTBOX_CREDIT=Created by Mike # the small revision mark at the bottom of every page
# NEXTBOX_OPERATOR=Braznarkel     # who runs this Next Box (shown on the Privacy, Terms and About pages)
# NEXTBOX_CONTACT=mike@braznarkel.com  # support email shown on those pages
# NEXTBOX_HOSTING=Cloudflare      # only if a service carries traffic to this Next Box (named on Privacy and About)
# TODOIST_TOKEN=               # legacy: used for the owner only, until they connect in Settings
# NEXTBOX_ALLOW_PRIVATE_URLS=1  # let people link a CalDAV server on your home network (off: safer with testers)

# "Sign in with Google / Microsoft / TickTick" (Google Tasks + Calendar, Microsoft To Do + Outlook
# Calendar, TickTick). Each needs a free one-time app registration; see README "Sign-in apps".
# NEXTBOX_PUBLIC_URL=https://nextbox.example.com
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=
# TICKTICK_CLIENT_ID=
# TICKTICK_CLIENT_SECRET=
