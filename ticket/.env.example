# Copy to .env and fill in. Never commit .env.
TODOIST_TOKEN=
PRINTER_IP=192.168.1.50
# Shared secret the web app, CLI-over-HTTP and Home Assistant send as X-Ticket-Key.
# Generate one with: python3 -c "import secrets; print(secrets.token_urlsafe(24))"
TICKET_KEY=
# For photo read-back (Phase 2 /scan).
ANTHROPIC_API_KEY=

# Optional
# TICKET_DRY_RUN=1            # never touch the printer; save PNGs instead
# TICKET_DATA_DIR=~/.local/share/ticket
# TICKET_LABEL=62             # 62 mm continuous tape
# TICKET_VISION_MODEL=claude-sonnet-5-5
# TICKET_HOST=0.0.0.0
# TICKET_PORT=8787
